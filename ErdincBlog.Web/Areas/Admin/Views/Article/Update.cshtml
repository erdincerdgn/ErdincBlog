@model ArticleAddDTO
<div class="container-xxl flex-grow-1 container-p-y">

    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">Article Management /</span> Add Article
    </h4>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <h5 class="card-header"></h5>
                <form asp-controller="Article" asp-action="Add" method="post" enctype="multipart/form-data">
                    <div class="card-body">
                        <div form-group>
                            <label asp-for="CategoryId" class="form-label">Category</label>
                            <!--ID ve Name ismi aynı olması gerekiyor dto ile-->
                            <select id="categoryList" class="form-control mb-3" asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories,"Id","Name"))"></select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>

                        </div>
                        <div form-group>
                            <label asp-for="Title" id="defaultFormControlInput" class="form-label">Title</label>
                            <input asp-for="Title" type="text" class="form-control mb-3" id="defaultFormControlInput" placeholder="Please enter a title text." aria-describedby="defaultFormControlHelp">

                        </div>
                        <div form-group>
                            <label asp-for="Content" for="defaultFormControlInput" class="form-label">Content</label>
                            <textarea asp-for="Content" type="text" class="form-control mb-3" id="defaultFormControlInput" style="min-height:300px;" placeholder="Please enter a content text." aria-describedby="defaultFormControlHelp"></textarea>

                        </div>


                        <div class="form-group">
                            <button type="submit" class="btn btn-primary btn-block">Save</button>
                        </div>


                    </div>
                </form>

            </div>
        </div>


    </div>

</div>