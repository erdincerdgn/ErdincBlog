@model List<ArticleDTO>

<div class="container-xxl flex-grow-1 container-p-y">


    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">Article Management /</span> Articles
    </h4>

    <!-- Basic Bootstrap Table -->
    <div class="card">
        
        <div class="table-responsive text-nowrap m-4">

            <a class="btn btn-success mb-3" asp-area="Admin" asp-controller="Article" asp-action="Add">
                Add Article<i class="bx bx-plus"></i>
            </a>
            
            <table class="table table-bordered" id="articlesTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Date of Creation</th>
                        <th>Writer</th>
                        <th>Status</th>
                        <th>Procedures</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Date of Creation</th>
                        <th>Writer</th>
                        <th>Status</th>
                        <th>Procedures</th>
                    </tr>
                </tfoot>
                <tbody class="table-border-bottom-0">
                    @*Eğer hata model'i gösteriyorsa controller yolladığımız view'da herhangi bir veri yok anlamına geliyor.*@
                    @foreach (var article in Model)
                    {
                        <tr name="@article.Id">
                            <td>@article.Title</td>
                            @*Eğer hata Category'yi gösteriyorsa bir include işlemi gerekebilir.*@
                            <td>@article.Category.Name</td>
                            <td>@article.CreatedDate.ToShortDateString()</td>
                            <td>@article.CreatedBy</td>
                            <td>@(article.IsDeleted ? "Inactive" : "Active")</td>
                            <td>
                                <a class="btn btn-primary btn-sm" data-id="@article.Id" asp-area="Admin" asp-controller="Article" asp-action="Update" asp-route-articleID="@article.Id"><i class="bx bxs-edit"></i></a>
                            </td>
                            

                        </tr>
                        
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!--/ Basic Bootstrap Table -->
</div>

@section Scripts {
    <script src="~/js/articleIndex.js" type="application/ecmascript"></script>
}